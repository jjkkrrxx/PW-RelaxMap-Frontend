# Скопіюйте цей файл у .env.local і заповніть значення.
# .env.local у git не потрапляє.

# Адреса бекенду, без /api у кінці.
# Локально — порт, на якому запущено PW-RelaxMap-Backend (PORT у його .env).
BACKEND_URL=http://localhost:4000

# Google Maps (форма створення й редагування локації).
# Потрапляють у браузер — у Google Cloud обмежте ключ за адресами сайту.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
